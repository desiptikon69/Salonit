# App Platform → «Переменные». Скопируйте значения в панель
# или переименуйте этот файл в .env и загрузите через «Загрузить из файла».
# Реальный .env с секретами не коммитьте.

# Строка подключения из панели PostgreSQL. Для TLS без проверки CA:
# ...?sslmode=no-verify
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB

# Точный адрес, по которому открывается сайт, без слэша на конце.
BETTER_AUTH_URL=https://YOUR-DOMAIN

# openssl rand -hex 48
BETTER_AUTH_SECRET=replace-with-openssl-rand-hex-48

APP_MODE=demo
INSTALLATION_ID=salonit-main
DEMO_PASSWORD=replace-with-random-demo-password
SEED_DEMO=1
RUN_MIGRATIONS=1
TZ=Europe/Moscow

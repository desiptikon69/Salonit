# Copy to deploy/.env and replace every value marked "replace-".
# Generate secrets with: openssl rand -hex 16 (password) / openssl rand -hex 48 (auth).

# Free Timeweb technical domain bound to this server, without https://
DOMAIN=salonit.tw1.su

# Exact public address of the app, including https:// and no trailing slash.
BETTER_AUTH_URL=https://salonit.tw1.su

# Use only hex characters here: the password is embedded into DATABASE_URL.
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-16
BETTER_AUTH_SECRET=replace-with-openssl-rand-hex-48

APP_MODE=demo
INSTALLATION_ID=salonit-main
DEMO_PASSWORD=replace-with-a-random-demo-password
SEED_DEMO=1

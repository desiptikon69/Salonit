{
  "name": "salonit",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run tests/unit",
    "test:integration": "tsx scripts/check-integration.ts",
    "test:e2e": "playwright test",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/reset.ts",
    "worker": "tsx scripts/worker.ts",
    "setup": "npm run db:migrate && npm run db:seed",
    "db:local": "tsx scripts/local-db.ts",
    "db:backup": "tsx scripts/backup.ts",
    "user:create": "tsx scripts/create-user.ts",
    "installation:init": "tsx scripts/init-installation.ts"
  },
  "dependencies": {
    "better-auth": "1.7.7",
    "clsx": "2.1.1",
    "csv-parse": "7.0.3",
    "dotenv": "18.0.7",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.55.0",
    "motion": "14.1.0",
    "next": "16.4.0",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "postcss": "8.5.29",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.4"
  }
}
